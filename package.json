{
  "name": "nmi-devops-shared-components-workspace",
  "version": "1.4.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20.9.0", "npm": ">=10" },
  "scripts": {
    "dev": "next dev",
    "predev": "npm run build:package && npm run build-storybook",
    "build": "npm run build:package && npm run build-storybook && next build",
    "build:package": "npm run build -w nmi-devops-shared-components",
    "build-storybook": "npm run docs:check && storybook build -o public/storybook && node scripts/prepare-storybook-output.mjs",
    "docs:check": "node scripts/check-storybook-coverage.mjs",
    "check": "npm run typecheck && npm run size:ads && npm run size:analytics && npm run lint && npm run test && npm run test:consumers && npm run build-storybook && next build",
    "lint": "eslint .",
    "pack:check": "npm pack -w nmi-devops-shared-components --dry-run",
    "pack:release": "node scripts/pack-release.mjs",
    "start": "next start",
    "size:ads": "npm run build:package && node scripts/check-ad-slot-size.mjs",
    "size:analytics": "npm run build:package && node scripts/check-google-analytics-size.mjs",
    "test": "vitest run",
    "test:consumers": "npm run build:package && node scripts/check-consumer-fixtures.mjs",
    "test:e2e": "playwright test",
    "typecheck": "npm run build:package && tsc --noEmit && npm run typecheck -w nmi-devops-shared-components"
  },
  "dependencies": {
    "nmi-devops-shared-components": "workspace:*",
    "next": "16.4.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^27.0.0",
    "playwright": "^1.50.0",
    "storybook": "^10.6.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
